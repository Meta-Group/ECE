# .gitignore for ECE
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# Pytest
.cache/

# VS Code
.vscode/

# MacOS
.DS_Store

# Logs
*.log

# Environment variables
.env
.env.*

# MyPy
.mypy_cache/
.dmypy.json

# Coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Pyre type checker
.pyre/

# Ignore generated experiment artifacts
results/
models/

# Ignore local temporary experiment files
.temp/
